rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Usernames collection: readable for search & uniqueness checks
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Users collection: Public profiles readable, authenticated users can write/update
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Stories collection: Anyone authenticated can read active stories and create/delete their own
    match /stories/{storyId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.userId == null);
    }

    // Posts collection: Public feed, authenticated users can post & like
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Friend Requests & Contacts
    match /friend_requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // Chat messages & conversations
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    match /chats/{chatId} {
      allow read, write: if request.auth != null;
    }

    // Default fallback rule for general development
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

