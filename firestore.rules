rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Usernames collection: Anyone can read to search/verify uniqueness, owners can write
    match /usernames/{username} {
      allow read: if true;
      allow write: if true;
    }

    // Users collection: Public profiles readable, owners can update
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Default rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
